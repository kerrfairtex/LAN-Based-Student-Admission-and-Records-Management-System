# Local development environment for TRAC JHS SARMS.
# Copy this file to ".env" and fill in the real values from the
# Render dashboard (https://dashboard.render.com → trac-jhs-sarms
# service → Environment tab).
#
# NEVER commit this file. .gitignore already excludes ".env".
#
# Why these vars exist: config/database.php reads DB_HOST / DB_PORT /
# DB_NAME / DB_USER / DB_PASS / DB_SCHEMA / DB_SSLMODE from getenv()
# and falls back to defaults if unset. The defaults point at
# localhost:6543 (Supabase pooler) and DB_SCHEMA=trac_jhs_sarms.
# For a Render-targeting dev setup, override the host/port/user/pass
# so your local PHP server hits the same managed Postgres Render uses.

# From Render → Environment for the trac-jhs-sarms web service
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASS=
DB_SCHEMA=trac_jhs_sarms

# require for managed Postgres (Render / Supabase),
# disable for the local .pgdata embedded cluster or a system postgres
DB_SSLMODE=require
