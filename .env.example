# TRAC JHS SARMS — Environment Configuration
#
# Copy this file to ".env" and fill in the real values.
# NEVER commit .env or .env.local — .gitignore already excludes them.
#
# On Vercel, configure these via the Vercel dashboard:
#   Project Settings → Environment Variables → Production
# Each variable must be set for the Production environment.

# --- Database (PostgreSQL) ---
# These are used by config/database.php via getenv().
# Connection string: pgsql:host=DB_HOST;port=DB_PORT;dbname=DB_NAME;sslmode=DB_SSLMODE
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASS=
DB_SCHEMA=trac_jhs_sarms
# require for managed Postgres (Supabase / Render), disable for local dev
DB_SSLMODE=require

# --- Application Environment ---
# Set to "production" to enable PostgreSQL-backed sessions and
# Supabase Storage for file uploads/backups.
# Leave unset or set to "development" for local dev (filesystem sessions).
APP_ENV=

# --- Session ---
# Session timeout in seconds (default: 1800 = 30 minutes)
SESSION_TIMEOUT=1800

# --- Storage (Required in production) ---
# On Vercel (APP_ENV=production), Supabase Storage is used for backups.
# On Render (Docker), STORAGE_DIR points to the persistent disk.
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_STORAGE_BUCKET=sarms-backups

# --- Supabase (Optional, for Supabase-native features) ---
# If your Postgres is hosted on Supabase, these may be useful.
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
