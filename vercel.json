{
    "name": "trac-jhs-sarms",
    "version": 2,
    "builds": [
        {
            "src": "*.php",
            "use": "vercel-php@0.9.0",
            "config": {
                "phpVersion": "8.3"
            }
        },
        {
            "src": "modules/**/*.php",
            "use": "vercel-php@0.9.0",
            "config": {
                "phpVersion": "8.3"
            }
        },
        {
            "src": "auth/**/*.php",
            "use": "vercel-php@0.9.0",
            "config": {
                "phpVersion": "8.3"
            }
        }
    ],
    "routes": [
        { "source": "/config/(.*)", "status": 404 },
        { "source": "/config", "status": 404 },
        { "source": "/includes/(.*)", "status": 404 },
        { "source": "/includes", "status": 404 },
        { "source": "/database/(.*)", "status": 404 },
        { "source": "/database", "status": 404 },
        { "source": "/backups/(.*)", "status": 404 },
        { "source": "/backups", "status": 404 },
        { "source": "/docs/(.*)", "status": 404 },
        { "source": "/docs", "status": 404 },
        { "source": "/tools/(.*)", "status": 404 },
        { "source": "/tools", "status": 404 },
        { "source": "/.user.ini", "status": 404 },
        { "source": "/.env", "status": 404 },
        { "source": "/.env.local", "status": 404 },
        { "source": "/.gitignore", "status": 404 },
        { "source": "/.htaccess", "status": 404 },
        { "source": "/composer.json", "status": 404 },
        { "source": "/vercel.json", "status": 404 },
        { "source": "/user-guidelines", "destination": "/user-guidelines.php" }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "^(.*)\\.php$",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "Referrer-Policy", "value": "same-origin" }
            ]
        },
        {
            "source": "^/auth/(login|logout)\\.php$",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Expires", "value": "0" }
            ]
        }
    ],
    "cleanOutputs": true
}
