Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive directories
    RewriteRule ^(?:config|includes|database|backups)/ - [F,L]

    # .user.ini is read by PHP at startup to set per-directory directives
    # (display_errors, error_log, etc.) — exposing it to the web would let
    # an attacker confirm those settings. 403 instead of 404 so the
    # existence of the file is not leaked either way.
    RewriteRule ^\.user\.ini$ - [F,L]
</IfModule>

# Security headers — emit unconditionally. mod_headers on Apache 2.4 sets
# these via "Header always set"; on Render + Cloudflare (no mod_headers),
# falls back to PHP's header() in includes/partials/header.php.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
</IfModule>

# If mod_headers is NOT loaded (e.g., Render with stock Apache config),
# these rules do nothing — PHP-side headers in includes/partials/header.php
# cover the same directives.

# Cache-Control / Expires — make static assets cacheable. mod_expires emits
# both Expires and Cache-Control: max-age; mod_headers below adds the
# Cache-Control directive for cases where mod_expires isn't loaded.
<IfModule mod_expires.c>
    ExpiresActive On

    # Default: 1 hour (HTML pages, dynamic responses).
    ExpiresDefault "access plus 1 hour"

    # Long-cache assets (1 year). Versioned via query string for cache-bust.
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/gif     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon  "access plus 1 year"
    ExpiresByType text/css      "access plus 1 year"
    ExpiresByType text/javascript    "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-font-ttf    "access plus 1 year"
    ExpiresByType application/x-font-woff   "access plus 1 year"
    ExpiresByType application/x-font-woff2  "access plus 1 year"
    ExpiresByType font/woff2     "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>

# Cache-Control directive — fallback for environments without mod_expires
# (e.g., Render with stock Apache config). The PHP-side fallback in
# includes/partials/header.php covers PHP-built-in dev server.
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|css|js|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Authentication routes must NEVER be cached, even by shared proxies.
    # no-store is stricter than no-cache (prevents storage entirely, not just
    # revalidation). Auth pages often contain CSRF tokens in the HTML or
    # session-bound redirects — caching them leaks the token or replays the
    # stale redirect. Also covers logout to prevent a back-button replay of
    # a "you have been signed out" page after a subsequent sign-in.
    <LocationMatch "^/(auth/(login|logout)\.php|index\.php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </LocationMatch>
</IfModule>
